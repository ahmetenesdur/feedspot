# Default Discord webhook. Used for unmatched reports and as the fallback for routes that define a fallback.
DISCORD_WEBHOOK_URL=

# Route-specific Discord webhooks.
DISCORD_GAMING_WEBHOOK_URL=
DISCORD_AI_PRODUCTS_WEBHOOK_URL=
DISCORD_SECURITY_WATCH_WEBHOOK_URL=
DISCORD_STARTUP_RADAR_WEBHOOK_URL=

# Optional route-specific webhooks. These fall back to DISCORD_WEBHOOK_URL when unset.
DISCORD_TECH_AI_WEBHOOK_URL=
DISCORD_GLOBAL_NEWS_WEBHOOK_URL=
DISCORD_MARKETS_WEBHOOK_URL=

# Optional fan-out target for the markets digest. Set this to post the same report to a second Discord channel.
DISCORD_MARKETS_SECONDARY_WEBHOOK_URL=

# Optional Discord delivery behavior. By default, link previews are suppressed.
# Set to 0 to allow Discord link previews.
DISCORD_SUPPRESS_EMBEDS=

# Optional local/testing flag. Set to 1 to make src/post-to-discord.mjs avoid webhook delivery.
DISCORD_DRY_RUN=

# Optional for Codex/tooling workflows that need GitHub API access.
GITHUB_TOKEN=
