  "webSearch": {
    "enabled": true,
    "lookbackHours": 48,
    "maxQueries": 32,
    "recencyDays": 3,
    "queries": [
      "actively exploited vulnerability CISA KEV patch",
      "critical CVE exploit patch cloud identity browser OS",
      "npm PyPI supply chain malware GitHub Actions token leak",
      "developer tool security advisory RCE patch",
      "ransomware breach data leak cloud provider security incident",
      "crypto wallet drainer exploit bridge protocol security incident",
      "Kubernetes Docker container vulnerability patch",
      "Chrome Firefox Safari zero day update"
    ],
    "officialDomainQueries": [
      "site:cisa.gov known exploited vulnerabilities added",
      "site:msrc.microsoft.com update guide critical exploited",
      "site:github.com/advisories npm PyPI critical",
