{
  "digest": {
    "slug": "security-watch",
    "title": "Security Watch",
    "reportPathTemplate": "reports/YYYY-MM-DD-security-watch.md",
    "language": "tr"
  },
  "cadence": {
    "watch": {
      "name": "Security Watch",
      "schedule": "daily",
      "lookbackHours": 48,
      "reportPathTemplate": "reports/YYYY-MM-DD-security-watch.md",
      "postOnlyIfMaterial": true,
      "skipReportWhenNoMaterialUpdates": true,
      "triggerIf": [
        "actively exploited vulnerability, CISA KEV addition, or emergency vendor advisory",
        "critical or high severity issue in widely used developer, browser, OS, cloud, identity, npm, PyPI, GitHub, CI/CD, container, Kubernetes, database, wallet, or crypto infrastructure",
        "major breach, supply-chain compromise, malware campaign, leaked credentials/tokens, ransomware incident, or wallet-drainer/exploit with practical defensive action",
        "patch or mitigation deadline that readers should act on within days"
      ],
      "rejectIfOnly": [
        "generic security awareness post, old CVE with no new exploit or patch context, vendor marketing, threat-intel teaser without indicators or action, or niche vuln without broad reader impact",
        "story cannot be traced to a primary advisory or two independent credible sources",
        "no practical action or monitoring value for developers, power users, or small teams"
      ]
    }
  },
  "rssLookbackHours": 48,
  "maxCandidates": 220,
  "timezone": "Europe/Istanbul",
  "audience": [
    "Geliştiriciler, küçük ekipler ve teknik power user'lar",
    "npm/PyPI/GitHub/CI/CD/cloud/browser/OS güvenlik etkilerini hızlı görmek isteyenler",
    "Crypto/Web3 altyapı, wallet, exchange ve token güvenliği risklerini izleyenler"
  ],
  "editorialWorkflow": {
    "minimumIndependentSourcesForNonPrimaryClaims": 2,
    "preferPrimarySources": true,
    "mustOpenAndVerifyCandidateLinks": true,
    "dedupeBy": ["canonicalUrl", "title", "cve", "package", "vendor", "campaign", "incident"],
    "rankBy": [
      "active exploitation or emergency patch",
      "breadth of affected users and systems",
      "developer or supply-chain impact",
      "cloud, identity, browser, OS, crypto, wallet, or package ecosystem impact",
      "clarity of mitigation or action"
    ],
    "rejectIf": [
      "source link is missing or circular",
      "claim is only social-media speculation",
      "no primary advisory or second credible source for non-primary claims",
      "no practical action, mitigation, or monitoring value",
      "date cannot be verified",
      "same story was already covered in recent automation memory without a material update"
    ]
  },
