{
  "digest": {
    "slug": "startup-radar",
    "title": "Weekly Startup / Product Radar",
    "reportPathTemplate": "reports/YYYY-MM-DD-startup-radar.md",
    "language": "tr"
  },
  "cadence": {
    "primary": {
      "name": "Weekly Startup / Product Radar",
      "schedule": "weekly",
      "recommendedDay": "Friday",
      "lookbackHours": 168,
      "reportPathTemplate": "reports/YYYY-MM-DD-startup-radar.md",
      "postWhenNoMajorNews": true,
      "guidance": [
        "Focus on useful new products, SaaS tools, AI tools, developer products, indie launches, and strong early traction signals.",
        "Prefer products the reader can try, evaluate, or learn from now.",
        "Avoid pure funding news, launch spam, clone products, thin directories, and marketing-only announcements without a concrete product."
      ]
    }
  },
  "rssLookbackHours": 168,
  "maxCandidates": 220,
  "timezone": "Europe/Istanbul",
  "audience": [
    "Yeni SaaS, AI tool, developer tool ve indie ürünleri denemeyi seven power user'lar",
    "Startup, ürün stratejisi ve growth sinyallerini takip eden kurucular",
    "Product Hunt, Hacker News, GitHub ve startup basınından yüksek-sinyal ürün keşfi isteyenler"
  ],
  "editorialWorkflow": {
    "minimumIndependentSourcesForNonPrimaryClaims": 2,
    "preferPrimarySources": true,
    "mustOpenAndVerifyCandidateLinks": true,
    "dedupeBy": ["canonicalUrl", "title", "product", "company", "founder", "domain"],
    "rankBy": [
      "useful product that can be tried now",
      "developer, AI, productivity, workflow, data, design, or infrastructure relevance",
      "clear differentiation or unusually good execution",
      "credible traction signal from Product Hunt, Hacker News, GitHub, customers, or reputable press",
      "learning value for builders and product-minded readers"
    ],
    "rejectIf": [
      "source link is missing or circular",
      "claim is only social-media speculation",
      "story is pure funding or valuation with no product change",
      "product is a thin directory, wrapper, clone, waitlist-only page, or SEO listicle",
      "date cannot be verified",
      "same product was already covered in recent automation memory without a material update"
    ]
  },
