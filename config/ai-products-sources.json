{
  "digest": {
    "slug": "ai-products",
    "title": "Weekly AI Product Updates Digest",
    "reportPathTemplate": "reports/YYYY-MM-DD-ai-products-digest.md",
    "language": "tr"
  },
  "cadence": {
    "primary": {
      "name": "Weekly AI Product Updates Digest",
      "schedule": "weekly",
      "recommendedDay": "Monday",
      "lookbackHours": 168,
      "reportPathTemplate": "reports/YYYY-MM-DD-ai-products-digest.md",
      "postWhenNoMajorNews": true,
      "guidance": [
        "Focus on product, model, API, pricing, availability, policy, and roadmap changes that affect real users or builders.",
        "Prefer official changelogs, release notes, pricing pages, and product announcements.",
        "Avoid generic AI thinkpieces, funding news without product impact, prompt roundups, and influencer speculation."
      ]
    }
  },
  "rssLookbackHours": 168,
  "maxCandidates": 180,
  "timezone": "Europe/Istanbul",
  "audience": [
    "AI ürünlerini düzenli kullanan power user'lar",
    "OpenAI, Anthropic, Google, Meta, Microsoft, Perplexity, Cursor, Windsurf ve Copilot gelişmelerini takip eden geliştiriciler",
    "Model, API, fiyatlandırma, limit, ürün özelliği ve erişilebilirlik değişikliklerinden etkilenebilecek ekipler"
  ],
  "editorialWorkflow": {
    "minimumIndependentSourcesForNonPrimaryClaims": 2,
    "preferPrimarySources": true,
    "mustOpenAndVerifyCandidateLinks": true,
    "dedupeBy": ["canonicalUrl", "title", "underlyingAnnouncement", "vendor", "product", "model"],
    "rankBy": [
      "direct user or developer impact",
      "model, API, pricing, usage limit, or availability change",
      "new or removed product capability",
      "workflow impact for coding, research, search, image/video/audio, agents, or enterprise users",
      "policy, safety, data, privacy, or terms change"
    ],
    "rejectIf": [
      "source link is missing or circular",
      "claim is only social-media speculation",
      "story is pure benchmark discourse without a product implication",
      "story is only funding, valuation, or executive commentary without product impact",
      "date cannot be verified",
      "same story was already covered in recent automation memory without a material update"
    ]
  },
